work/
output/
.venv/
venv/
__pycache__/
*.pyc
.env

# Vendored ffmpeg build (~300MB of binaries) - see README.md for how to get
# one; config/settings.json's tools.ffmpeg/tools.ffprobe point at it locally.
ffmpeg-*-essentials_build/

# Stale, unused - see CLAUDE.md's repo map note in server/static.
*.bak

# Claude Code: settings.json (shared) is tracked; local-only overrides and
# session/runtime state are not.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# YouTube upload credentials (stage 6a). The OAuth client JSON is downloaded
# from Google Cloud Console and the login token lives under work/_cache/, which
# is already ignored via work/. These patterns make sure a client secret can
# never be committed by accident, wherever it ends up.
config/youtube_client_secret.json
client_secret*.json
youtube_token*.json
